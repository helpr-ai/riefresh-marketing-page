---
import Layout from "../layouts/Layout.astro";
import FaqItem from "../components/FaqItem.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import DemoForm from "../components/DemoForm.astro";

const faqs = [
  {
    q: "Verzint de AI geen risico’s?",
    a: "Bevindingen komen alleen uit wat in de AI-voicegesprekken is gezegd, en per bevinding zijn de bronnen te openen. Is een onderwerp niet besproken, dan staat er dat er onvoldoende informatie is.",
  },
  {
    q: "Klopt het beeld met de praktijk?",
    a: "Meestal spreken meerdere mensen over hetzelfde onderwerp. Tegenstrijdige antwoorden worden gemarkeerd, en de rondgang van de veiligheidskundige toetst het beeld op de vloer.",
  },
  {
    q: "Hoe lang duurt een AI-voicegesprek?",
    a: "Tien tot vijftien minuten. Een deelnemer krijgt alleen de onderwerpen die bij zijn rol horen, soms verdeeld over meerdere korte AI-voicegesprekken.",
  },
  {
    q: "Wie ondertekent de RI&E?",
    a: "De veiligheidskundige die het traject begeleidt. Is toetsing verplicht, dan toetst een gecertificeerde kerndeskundige de RI&E en het plan van aanpak.",
  },
  {
    q: "Zijn de AI-voicegesprekken anoniem?",
    aHtml:
      'Anonimiteit is per klant in te stellen. Hoe we met gegevens omgaan, lees je in onze <a href="/privacy">privacyverklaring</a>. <!-- TODO: [PRIVACYVERKLARING] Jorien -->',
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "RIEfresh",
    url: "https://riefresh.nl",
    parentOrganization: {
      "@type": "Organization",
      name: "Helpr.ai",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: f.a ?? f.aHtml?.replace(/<[^>]+>/g, ""),
      },
    })),
  },
];
---

<Layout
  title="RIEfresh — RI&E via AI-voicegesprekken"
  description="In korte AI-voicegesprekken halen we de kennis op bij de mensen die het werk kennen. Complete RI&E met plan van aanpak, voor een fractie van een adviestraject."
  current="home"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero container">
    <div class="hero__text">
      <p class="pill pill--with-dot">
        <span class="pill__dot" aria-hidden="true"></span>
        RI&amp;E via AI-voicegesprekken
      </p>
      <h1 class="hero__title">
        De werkvloer weet waar de risico’s zitten. Wij voeren het gesprek.
      </h1>
      <p class="hero__lead">
        In korte AI-voicegesprekken halen we de kennis op bij de mensen die het werk kennen.
        Jij krijgt een complete RI&amp;E met plan van aanpak, voor een fractie van een
        adviestraject.
      </p>
      <div class="hero__cta">
        <a href="#demo" class="btn btn-primary">Plan een demo</a>
        <a href="#video" class="btn btn-secondary">Bekijk de uitlegvideo</a>
      </div>
      <p class="hero__proof">
        Standaard in de RI&amp;E-trajecten van CertificeringsAdvies Nederland · Eerste
        volledige RI&amp;E bij Microtherm (Vink Groep)
      </p>
    </div>

    <div class="hero__cards">
      <div class="chat-card">
        <div class="chat-card__head">
          <span class="chat-card__title">AI-voicegesprek · Operationele medewerker</span>
          <span>12 min</span>
        </div>
        <div class="chat">
          <div class="chat__bubble chat__bubble--ai">
            Wie rijden er bij jullie op de heftruck?
          </div>
          <div class="chat__bubble chat__bubble--user">
            Eigenlijk iedereen die het kan.
          </div>
          <div class="chat__bubble chat__bubble--ai">
            Is daar een opleiding of aanwijzing voor vastgelegd?
          </div>
          <div class="chat__bubble chat__bubble--user">
            Niet echt, je leert het van collega’s.
          </div>
        </div>
      </div>
      <div class="finding-card">
        <div class="finding-card__head">
          <span class="chat-card__title">Bevinding · Aanrijdgevaar</span>
          <span>3 bronnen</span>
        </div>
        <p class="finding-card__body">
          Heftruck wordt bediend zonder vastgelegde instructie; looproutes in het magazijn
          zijn niet gemarkeerd.
        </p>
        <div class="tags">
          <span class="tag">Effect 7</span>
          <span class="tag">Blootstelling 3</span>
          <span class="tag">Waarschijnlijkheid 1</span>
          <span class="tag tag--warn">Score 21 · middel</span>
        </div>
      </div>
      <p class="hero__cards-note">Illustratief voorbeeld</p>
    </div>
  </section>

  <!-- Klantenbalk -->
  <section aria-labelledby="klanten" class="klanten">
    <div class="container klanten__inner">
      <h2 id="klanten" class="eyebrow">Klanten</h2>
      <ul class="klanten__list">
        <li>
          <img
            src="/assets/logos/certificeringsadvies-nederland.png"
            alt="CertificeringsAdvies Nederland"
            height="44"
            loading="lazy"
          />
        </li>
        <li>
          <img
            src="/assets/logos/van-houten-partners.png"
            alt="Van Houten & Partners"
            height="44"
            loading="lazy"
          />
        </li>
        <li>
          <img src="/assets/logos/vink-groep.png" alt="Vink Groep" height="44" loading="lazy" />
        </li>
        <li>
          <img src="/assets/logos/microtherm.png" alt="Microtherm" height="38" loading="lazy" />
        </li>
        <li>
          <span class="klanten__wordmark">Coning Adviesgroep</span>
          <!-- TODO: logo Coning Adviesgroep ontbreekt nog -->
        </li>
      </ul>
    </div>
  </section>

  <!-- Waarom -->
  <section aria-labelledby="waarom" class="section-dark">
    <div class="container waarom">
      <h2 id="waarom" class="waarom__title">
        Elke werkgever moet een RI&amp;E hebben. Ruim de helft heeft er geen goede.
      </h2>
      <div class="stats">
        <div class="stat">
          <p class="stat__num">68%</p>
          <p class="stat__desc">van de bedrijven heeft een RI&amp;E. Bijna een derde heeft er dus geen.</p>
        </div>
        <div class="stat">
          <p class="stat__num">30%</p>
          <p class="stat__desc">van de RI&amp;E’s die er wél zijn, scoort onvoldoende op kwaliteit.</p>
        </div>
        <div class="stat">
          <p class="stat__num">1 juli</p>
          <p class="stat__desc">
            2026: alle werkgevers moeten medewerkers raadplegen over het arbobeleid, ook over de
            RI&amp;E.
          </p>
        </div>
        <div class="stat">
          <p class="stat__num">€4.500</p>
          <p class="stat__desc">
            boete zonder RI&amp;E, plus tot €3.000 als het plan van aanpak ontbreekt (hoogste
            normbedragen).
          </p>
        </div>
      </div>
      <p class="sources">
        Bronnen: Nederlandse Arbeidsinspectie, monitor Arbo in Bedrijf (via Salaris Vanmorgen,
        23 april 2026) · Arbowet artikel 12, gewijzigd per 1 juli 2026 · Beleidsregel
        boeteoplegging arbeidsomstandighedenwetgeving
      </p>
    </div>
  </section>

  <!-- Drie routes -->
  <section aria-labelledby="routes" class="container section-lg">
    <p class="eyebrow">Drie routes</p>
    <h2 id="routes" class="h2">Tot nu toe was een RI&amp;E grondig óf betaalbaar</h2>
    <div class="grid routes">
      <div class="card">
        <p class="route__badge">Route 1</p>
        <h3 class="route__title">De adviseur doet alles</h3>
        <p class="route__lead">Gesprekken, rondgang en rapport door de veiligheidskundige.</p>
        <p class="route__pro">+ Grondig en compleet</p>
        <p class="route__con">− Veel uren, en dus een prijs die bij eenvoudige trajecten verliest</p>
      </div>
      <div class="card">
        <p class="route__badge">Route 2</p>
        <h3 class="route__title">Zelf een lijst invullen</h3>
        <p class="route__lead">Een standaardvragenlijst, zonder gesprek en zonder doorvragen.</p>
        <p class="route__pro">+ Lage kosten</p>
        <p class="route__con">− Wat je zelf niet bedenkt, staat er niet in</p>
      </div>
      <div class="card card--dark">
        <p class="route__badge route__badge--lime">Route 3 · RIEfresh</p>
        <h3 class="route__title">AI-voicegesprekken plus oordeel</h3>
        <p class="route__lead route__lead--dark">
          Medewerkers vertellen het aan de AI-interviewer. De adviseur beoordeelt, doet de
          rondgang en toetst.
        </p>
        <p class="route__pro route__pro--on-dark">+ Grondig én minder uren</p>
        <p class="route__pro route__pro--on-dark">+ De RI&amp;E blijft daarna actueel</p>
      </div>
    </div>
    <p class="routes__tagline">Het comfort van een adviseur, voor de prijs van doe-het-zelf.</p>
  </section>

  <!-- Video -->
  <section id="video" aria-labelledby="video-titel" class="container section">
    <div class="video-block">
      <div class="video-block__text">
        <p class="eyebrow video-block__eyebrow">Uitlegvideo</p>
        <h2 id="video-titel" class="video-block__title">
          Zie hoe een RI&amp;E via AI-voicegesprekken tot stand komt
        </h2>
        <p class="video-block__lead">Een korte rondleiding door het platform.</p>
      </div>
      <VideoEmbed videoId="u7Od_vE2nu4" title="RIEfresh uitlegvideo" />
    </div>
  </section>

  <!-- Hoe het werkt -->
  <section id="hoe" aria-labelledby="hoe-titel" class="container section">
    <p class="eyebrow">Hoe het werkt</p>
    <h2 id="hoe-titel" class="h2 h2--max820">
      Automatiseer het uitvragen. Investeer in het oordeel.
    </h2>
    <p class="section__lead">
      Vijf stappen. De veiligheidskundige staat aan het begin en aan het eind; daartussen
      vertellen de mensen die het werk kennen hoe het echt gaat.
    </p>
    <ol class="steps">
      <li class="step">
        <p class="step__num">1</p>
        <p class="step__role">Adviseur</p>
        <h3 class="step__title">Inrichten</h3>
        <p class="step__body">Klantprofiel, vestigingen en scope, samen met de klant.</p>
      </li>
      <li class="step">
        <p class="step__num">2</p>
        <p class="step__role">Platform</p>
        <h3 class="step__title">Onderwerpen</h3>
        <p class="step__body">Een voorstel op basis van branche en context. De adviseur legt de lijst vast.</p>
      </li>
      <li class="step">
        <p class="step__num">3</p>
        <p class="step__role">Medewerkers</p>
        <h3 class="step__title">AI-voicegesprekken</h3>
        <p class="step__body">
          Van werkvloer tot directie. Tien tot vijftien minuten per AI-voicegesprek, op telefoon
          of computer.
        </p>
      </li>
      <li class="step">
        <p class="step__num">4</p>
        <p class="step__role">Platform</p>
        <h3 class="step__title">Bevindingen</h3>
        <p class="step__body">
          Per onderwerp een bevinding en een Fine &amp; Kinney-score, met de bronnen erbij.
        </p>
      </li>
      <li class="step">
        <p class="step__num">5</p>
        <p class="step__role">Adviseur</p>
        <h3 class="step__title">Oordeel en rondgang</h3>
        <p class="step__body">
          Beoordelen, rondgang, toetsing en het plan van aanpak vaststellen.
        </p>
      </li>
    </ol>
    <div class="fresh">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#10362D" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 11a8 8 0 0 0-14.9-3.9"></path>
        <path d="M4 4v4h4"></path>
        <path d="M4 13a8 8 0 0 0 14.9 3.9"></path>
        <path d="M20 20v-4h-4"></path>
      </svg>
      <p>
        <strong>Elk jaar vers.</strong> Voor de update draai je alleen stap 3 en 4 opnieuw: een
        nieuwe ronde AI-voicegesprekken laat zien wat er in de organisatie is veranderd.
      </p>
    </div>
  </section>

  <!-- Voor de medewerker -->
  <section aria-labelledby="ervaring" class="container section ervaring">
    <div class="ervaring__text">
      <p class="eyebrow">Voor de medewerker</p>
      <h2 id="ervaring" class="h2 h2--md">Een AI-voicegesprek, geen formulier</h2>
      <ul class="dot-list">
        <li>
          <strong>Als een gesprek met een expert.</strong> We hebben de interviewer zo gebouwd
          dat het voelt als praten met een ervaren veiligheidskundige. Hij kent de
          RI&amp;E-onderwerpen, stelt open vragen en vraagt door op voorbeelden uit je eigen
          werk.
        </li>
        <li>
          <strong>Alleen wat bij je rol hoort.</strong> Wie weinig van een onderwerp weet, is
          snel klaar; wie er veel van weet, krijgt de vervolgvragen.
        </li>
        <li>
          <strong>Hij luistert echt.</strong> De interviewer vat samen, checkt of hij je goed
          begreep en onthoudt wat je in eerdere gesprekken zei.
        </li>
        <li>
          <strong>Eigen moment, tempo en taal.</strong> Geen afspraak inplannen. Weet je iets
          niet, dan noteert de interviewer dat als open punt voor de veiligheidskundige.
        </li>
      </ul>
    </div>
    <figure class="quote-card">
      <blockquote>
        “Hij onthield wat ik in eerdere gesprekken had gezegd. Fijn dat je niet drie keer
        hetzelfde hoeft te zeggen.”
      </blockquote>
      <figcaption>
        <strong>Kevin Visser</strong>, general manager Microtherm
      </figcaption>
    </figure>
  </section>

  <!-- Voor de veiligheidskundige -->
  <section aria-labelledby="adviseur" class="container section">
    <p class="eyebrow">Voor de veiligheidskundige</p>
    <h2 id="adviseur" class="h2 h2--md h2--max760">Van losse antwoorden naar de grondoorzaak</h2>
    <p class="section__lead">
      Elk onderwerp krijgt één bevinding met een Fine &amp; Kinney-score. Achter elke
      bevinding staan de AI-voicegesprekken waar hij uit komt. Spreken mensen elkaar tegen,
      dan markeert het platform het onderwerp om verder uit te diepen.
    </p>
    <div class="table-card">
      <table>
        <thead>
          <tr>
            <th scope="col">Onderwerp</th>
            <th scope="col">Bevinding</th>
            <th scope="col">E</th>
            <th scope="col">B</th>
            <th scope="col">W</th>
            <th scope="col">Score</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td data-label="Onderwerp" class="td-bold">Aanrijdgevaar</td>
            <td data-label="Bevinding" class="td-muted">
              Loop- en transportroutes in werkplaats en magazijn zijn niet gescheiden.
            </td>
            <td data-label="E">7</td>
            <td data-label="B">3</td>
            <td data-label="W">1</td>
            <td data-label="Score"><span class="tag tag--warn">21 middel</span></td>
          </tr>
          <tr>
            <td class="td-bold">Tillen en dragen</td>
            <td class="td-muted">
              Handmatig tillen van zware dozen bij het orderverzamelen.
            </td>
            <td>3</td>
            <td>6</td>
            <td>3</td>
            <td><span class="tag tag--alert">54 hoog</span></td>
          </tr>
          <tr>
            <td class="td-bold">Vervoermiddelen</td>
            <td class="td-muted">
              Tegenstrijdige antwoorden over de keuring van de bedrijfsbus.
            </td>
            <td>3</td>
            <td>6</td>
            <td>0,5</td>
            <td><span class="tag tag--soft">Verder uitdiepen</span></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="caption">
      Nagebouwd scherm met voorbeeldgegevens. Score, status en maatregel zijn per bevinding
      aan te passen.
    </p>
  </section>

  <!-- Voor wie -->
  <section aria-labelledby="voor-wie" class="container section">
    <h2 id="voor-wie" class="h2">Voor wie is RIEfresh?</h2>
    <div class="grid audiences">
      <a href="/kam-managers" class="audience">
        <p class="audience__kicker">KAM-managers en preventiemedewerkers</p>
        <h3 class="audience__title">
          Elke vestiging een actuele RI&amp;E, zonder dat de vloer stilvalt
        </h3>
        <ul class="audience__bullets">
          <li>Je doet het zelf, met een externe toetser, zoals Microtherm</li>
          <li>Medewerkers praten mee, op hun eigen moment</li>
          <li>Per vestiging bevindingen, scores en een plan van aanpak</li>
          <li>Locatiemanagers werken hun eigen actiepunten af</li>
        </ul>
        <span class="audience__cta">Bekijk de pagina voor KAM-managers →</span>
      </a>
      <a href="/adviesbureaus" class="audience">
        <p class="audience__kicker">Adviesbureaus en arbodiensten</p>
        <h3 class="audience__title">Minder uren per traject, meer ruimte voor het oordeel</h3>
        <ul class="audience__bullets">
          <li>Van circa 12 naar circa 5 adviseursuren bij een eenvoudige RI&amp;E</li>
          <li>Je bepaalt zelf de eindprijs voor je klant</li>
          <li>De jaarlijkse update is een vast moment voor vervolgadvies</li>
        </ul>
        <span class="audience__cta">Bekijk de pagina voor adviesbureaus →</span>
      </a>
    </div>
  </section>

  <!-- Uit de praktijk: Microtherm -->
  <section aria-labelledby="praktijk" class="container section">
    <p class="eyebrow">Uit de praktijk</p>
    <h2 id="praktijk" class="h2">Microtherm: de eerste RI&amp;E via AI-voicegesprekken</h2>
    <!--
      TODO: Na 8 december 2026 moet de toetsing bij Microtherm in de verleden tijd,
      liefst met een quote van de toetser.
    -->
    <div class="praktijk">
      <div class="praktijk__main card">
        <p class="praktijk__meta">
          Microtherm Kunststoffen, werkmaatschappij van Vink Groep · 31 medewerkers · één
          locatie
        </p>
        <p class="praktijk__intro">
          Microtherm deed de RI&amp;E zelf, met de eigen KAM-adviseur van Vink. Wij richtten
          samen in, de medewerkers voerden de AI-voicegesprekken, en een externe hogere
          veiligheidskundige toetst.
        </p>
        <div class="praktijk__stats">
          <div>
            <p class="praktijk__stat">6</p>
            <p class="praktijk__stat-desc">deelnemers, van directie tot OR</p>
          </div>
          <div>
            <p class="praktijk__stat">42</p>
            <p class="praktijk__stat-desc">AI-voicegesprekken afgerond</p>
          </div>
          <div>
            <p class="praktijk__stat">10–15</p>
            <p class="praktijk__stat-desc">minuten per AI-voicegesprek</p>
          </div>
        </div>
        <ol class="timeline">
          <li><strong>7 oktober</strong>Kick-off met de deelnemers</li>
          <li><strong>Eind oktober</strong>Concept-RI&amp;E met plan van aanpak</li>
          <li><strong>November</strong>Rondgang op locatie</li>
          <li class="timeline__future"><strong>8 december</strong>Toetsing door een externe hogere veiligheidskundige</li>
        </ol>
        <figure class="quote">
          <blockquote>“De tool deed precies wat ik ervan had verwacht en gehoopt.”</blockquote>
          <figcaption>
            <strong>Erik Duis</strong>, KAM &amp; MVO-adviseur Vink Groep
          </figcaption>
        </figure>
      </div>
      <div class="praktijk__side">
        <figure class="quote-dark">
          <blockquote>
            “De eerste klant was al binnen 2 weken akkoord, het signaal dat we op de juiste weg
            zitten en onze klanten deze innovatieve methode zonder twijfel omarmen!”
          </blockquote>
          <figcaption>
            <strong>Steven Zwarts</strong>, manager Advies &amp; Opleidingen,
            CertificeringsAdvies Nederland
          </figcaption>
        </figure>
        <div class="card praktijk__nps">
          <p class="praktijk__nps-head">
            Dezelfde AI-interviewer in de Safety Culture Ladder-trajecten van Enexis:
          </p>
          <p class="praktijk__nps-row"><span>90%</span> van de deelnemers zeer positief</p>
          <p class="praktijk__nps-row"><span>87%</span> vond het (zeer) gebruiksvriendelijk</p>
          <p class="praktijk__nps-row"><span>85%</span> zou opnieuw meedoen</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Grenzen -->
  <section aria-labelledby="grenzen" class="container section">
    <p class="eyebrow">Eerlijk over de grenzen</p>
    <h2 id="grenzen" class="h2">Wat RIEfresh bewust niet doet</h2>
    <div class="grid grenzen">
      <div class="grens">
        <h3>Geen rondgang</h3>
        <p>Een onbeschermde zaag zie je alleen op de vloer. De rondgang wordt wel gerichter.</p>
      </div>
      <div class="grens">
        <h3>Geen toetsing</h3>
        <p>Het vervangt de kerndeskundige niet. Een externe toetser koppel je aan de RI&amp;E.</p>
      </div>
      <div class="grens">
        <h3>Geen eindoordeel</h3>
        <p>
          Bevindingen en maatregelen blijven concept tot de veiligheidskundige ze heeft
          beoordeeld.
        </p>
      </div>
      <div class="grens">
        <h3>Geen kwaliteit zonder inrichting</h3>
        <p>
          De AI-voicegesprekken zijn zo goed als de context en onderwerpen die de adviseur
          vastlegt.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="vragen" aria-labelledby="vragen-titel" class="container section faq">
    <div class="faq__intro">
      <h2 id="vragen-titel" class="h2">Veelgestelde vragen</h2>
      <p class="faq__sub">
        Specifieke vragen voor jouw rol staan op de pagina’s voor
        <a href="/adviesbureaus">adviesbureaus</a> en
        <a href="/kam-managers">KAM-managers</a>.
      </p>
    </div>
    <div class="faq__list">
      {
        faqs.map((f) => (
          <FaqItem question={f.q}>
            {f.aHtml ? <p set:html={f.aHtml} /> : <p>{f.a}</p>}
