---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Privacy — RIEfresh"
  description="Hoe RIEfresh omgaat met persoonsgegevens en de AI-voicegesprekken."
  canonical="https://riefresh.nl/privacy"
  footerIncludeHome={true}
>
  <section class="container privacy">
    <p class="eyebrow">Privacy</p>
    <h1 class="privacy__title">Privacyverklaring</h1>
    <!--
      TODO: [PRIVACYVERKLARING] — definitieve tekst volgt van Jorien.
      Onderstaande is een placeholder-skelet, geen juridisch bindend document.
    -->
    <div class="privacy__body">
      <p class="privacy__note">
        <strong>Placeholder.</strong> Deze pagina wordt nog aangevuld met de officiële
        privacyverklaring van RIEfresh. Vragen over gegevensverwerking? Neem contact op via
        het <a href="/#demo">contactformulier</a>.
      </p>

      <h2>Wie we zijn</h2>
      <p>
        RIEfresh is een product van Helpr.ai. We verwerken gegevens om de RI&amp;E via
        AI-voicegesprekken mogelijk te maken: onderwerpen voorstellen, uitnodigingen
        versturen, gesprekken opnemen en samenvatten tot bevindingen.
      </p>

      <h2>Welke gegevens we verwerken</h2>
      <ul>
        <li>Naam en contactgegevens van deelnemers</li>
        <li>De inhoud en transcripten van AI-voicegesprekken</li>
        <li>Bevindingen en scores die daaruit voortkomen</li>
      </ul>

      <h2>Grondslag en bewaartermijn</h2>
      <p>Wordt aangevuld.</p>

      <h2>Jouw rechten</h2>
      <p>Wordt aangevuld.</p>

      <h2>Contact</h2>
      <p>Wordt aangevuld.</p>
    </div>
  </section>
</Layout>

<style>
  .privacy {
    padding-top: 56px;
    padding-bottom: 96px;
    max-width: 760px;
  }
  .privacy__title {
    margin: 10px 0 24px;
    font-size: clamp(32px, 4vw, 48px);
  }
  .privacy__note {
    background: var(--c-bg-soft);
    border-radius: 14px;
    padding: 18px 20px;
    margin: 0 0 32px;
    font-size: 15px;
  }
  .privacy__body h2 {
    margin-top: 32px;
    font-size: 24px;
  }
  .privacy__body p,
  .privacy__body ul {
    margin-top: 12px;
    color: var(--c-text-2);
  }
  .privacy__body ul {
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
</style>
