---
import Layout from "../layouts/Layout.astro";
import FaqItem from "../components/FaqItem.astro";
import DemoForm from "../components/DemoForm.astro";
import { kamPricing } from "../data/pricing";

const faqs = [
  {
    q: "Hoeveel tijd kost het mijn medewerkers?",
    a: "Tien tot vijftien minuten per AI-voicegesprek, op een moment dat het hun uitkomt. Wie veel onderwerpen kent, krijgt er soms een paar; die kunnen over meerdere dagen worden verdeeld.",
  },
  {
    q: "Wie moet er meedoen?",
    a: "Per thema iemand die het werk kent: directie voor het beleid, iemand voor de locatie en een paar mensen uit de uitvoering. Je kiest zelf wie, en kunt per thema meerdere mensen uitnodigen.",
  },
  {
    q: "En als iemand iets niet weet?",
    a: "Dan vraagt de AI-interviewer wie het wel weet, en noteert hij een open punt voor de veiligheidskundige. Onderwerpen die onvoldoende besproken zijn, worden gemarkeerd om verder uit te diepen.",
  },
  {
    q: "Kunnen medewerkers in hun eigen taal praten?",
    a: "Ja. Het AI-voicegesprek kan in de taal waarin iemand zich het best uitdrukt, en de bevindingen verschijnen in het Nederlands.",
  },
  {
    q: "Wat betekent dit voor de OR?",
    a: "De OR heeft instemmingsrecht op de RI&E en het plan van aanpak. OR-leden kunnen ook zelf een AI-voicegesprek voeren; daar is een apart thema voor.",
  },
  {
    q: "Moet de RI&E getoetst worden?",
    a: "Bij meer dan 25 medewerkers meestal wel, door een gecertificeerde kerndeskundige. De Tweede Kamer vraagt het kabinet de toetsing te heroverwegen, maar voorlopig blijven de huidige regels gelden.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout
  title="RIEfresh voor KAM-managers — elke vestiging een actuele RI&E"
  description="Houd met RIEfresh elke vestiging in beeld: AI-voicegesprekken met je medewerkers, bevindingen en een plan van aanpak dat je samen met locatiemanagers afwerkt."
  current="kam"
  jsonLd={jsonLd}
  footerIncludeKam={false}
  footerIncludeHome={true}
>
  <!-- Hero -->
  <section class="hero container">
    <div class="hero__text">
      <p class="pill">Voor KAM-managers en preventiemedewerkers</p>
      <h1 class="hero__title">Elke vestiging een actuele RI&amp;E. Zonder dat de vloer stilvalt.</h1>
      <p class="hero__lead">
        De kennis over risico’s zit bij de mensen op de vloer, verspreid over locaties en
        ploegen. RIEfresh spreekt ze allemaal, in AI-voicegesprekken van tien tot vijftien
        minuten op een eigen moment. Jij krijgt per vestiging de bevindingen, de scores en een
        plan van aanpak dat je samen met je locatiemanagers afwerkt.
      </p>
      <div class="hero__cta">
        <a href="#demo" class="btn btn-primary">Plan een demo</a>
        <a href="#organisatie" class="btn btn-secondary">Zo loopt het intern</a>
      </div>
    </div>
    <div class="hero__side">
      <div class="vestigingen">
        <div class="vestigingen__head">
          <p class="vestigingen__title">Vestigingen</p>
          <p class="vestigingen__meta">RI&amp;E 2027</p>
        </div>
        <ul class="vestigingen__list">
          <li>
            <span>
              <strong>Hoofdvestiging</strong>
              <span class="vestigingen__sub">8 van 8 gesprekken · 12 actiepunten</span>
            </span>
            <span class="badge badge--ok">Plan van aanpak</span>
          </li>
          <li>
            <span>
              <strong>Vestiging Noord</strong>
              <span class="vestigingen__sub">5 van 7 gesprekken</span>
            </span>
            <span class="badge badge--warn">Gesprekken lopen</span>
          </li>
          <li>
            <span>
              <strong>Vestiging Zuid</strong>
              <span class="vestigingen__sub">Laatste ronde: maart 2026</span>
            </span>
            <span class="badge badge--soft">Update gepland</span>
          </li>
        </ul>
      </div>
      <p class="hero__note">Illustratief voorbeeld</p>
    </div>
  </section>

  <!-- Herkenbaar -->
  <section aria-labelledby="herkenbaar" class="section-dark">
    <div class="container herkenbaar">
      <h2 id="herkenbaar" class="h2 herkenbaar__title">
        De RI&amp;E is af. En dan verandert er iets.
      </h2>
      <div class="herkenbaar__grid">
        <div class="herkenbaar__card">
          <h3>Elke vestiging, elke verandering</h3>
          <p>
            Voor elke vestiging maak je een eigen inventarisatie, en een RI&amp;E moet actueel
            zijn. Na een verbouwing, nieuwe machines of een reorganisatie loopt hij al achter.
          </p>
        </div>
        <div class="herkenbaar__card">
          <h3>De kennis zit op de vloer</h3>
          <p>
            Wie het werk doet, ziet de risico’s. Maar met ploegendiensten, drukte en meerdere
            locaties krijg je die mensen moeilijk aan tafel.
          </p>
        </div>
        <div class="herkenbaar__card">
          <h3>Medewerkers raadplegen is verplicht</h3>
          <p>
            Sinds 1 juli 2026 moeten alle werkgevers medewerkers raadplegen over het
            arbobeleid, ook over de RI&amp;E. Zonder OR of PVT raadpleeg je de medewerkers
            zelf.
          </p>
        </div>
        <div class="herkenbaar__card">
          <h3>Het plan van aanpak verstoft</h3>
          <p>
            Het plan van aanpak moet aangeven welke maatregelen je neemt en binnen welke
            termijn. Een losse spreadsheet houdt dat zelden levend.
          </p>
        </div>
      </div>
      <p class="sources">
        Bronnen: KVK, “Verplichte RI&amp;E beschermt je werknemers tegen gevaar” ·
        Ondernemersplein, RI&amp;E voor personeel · Arbowet artikel 5 en 12
      </p>
    </div>
  </section>

  <!-- Organisatie -->
  <section id="organisatie" aria-labelledby="organisatie-titel" class="container section-lg">
    <p class="eyebrow">Zo loopt het intern</p>
    <h2 id="organisatie-titel" class="h2 h2--max820">
      Iedereen doet het deel dat bij zijn rol past
    </h2>
    <div class="grid roles">
      <div class="role role--dark">
        <p class="role__kicker role__kicker--lime">Jij</p>
        <h3 class="role__title">KAM-manager of preventiemedewerker</h3>
        <p>
          Houdt de regie, volgt de voortgang van de AI-voicegesprekken en ziet alle punten in
          het plan van aanpak.
        </p>
      </div>
      <div class="role">
        <p class="role__kicker">Per vestiging</p>
        <h3 class="role__title">Locatiemanager</h3>
        <p>
          Werkt de actiepunten van de eigen vestiging af: status, deadline en wie het oppakt.
        </p>
      </div>
      <div class="role">
        <p class="role__kicker">Kennisdragers</p>
        <h3 class="role__title">Medewerkers</h3>
        <p>
          Voeren korte AI-voicegesprekken over de onderwerpen van hun rol: directie,
          operations, BHV, facilitair, technische dienst, uitvoering of OR.
        </p>
      </div>
      <div class="role">
        <p class="role__kicker">Vakinhoudelijk</p>
        <h3 class="role__title">Veiligheidskundige</h3>
        <p>
          Beoordeelt de bevindingen, doet de rondgang en toetst. Je eigen adviseur, of een
          externe toetser uit ons netwerk.
        </p>
      </div>
    </div>
    <p class="section__lead">
      Meestal doet per vestiging een handvol mensen mee: iemand voor het beleid, iemand voor
      de locatie en een paar mensen uit de uitvoering. Je kiest zelf wie.
    </p>
  </section>

  <!-- PvA -->
  <section aria-labelledby="pva" class="container section">
    <p class="eyebrow">Plan van aanpak</p>
    <h2 id="pva" class="h2 h2--max820">Een plan van aanpak waar je echt mee werkt</h2>
    <p class="section__lead">
      Bevindingen met een hoog risico of te weinig informatie komen automatisch in het plan
      van aanpak. Per maatregel leg je de status, de deadline en de verantwoordelijke vast,
      en je filtert per vestiging.
    </p>
    <div class="pva">
      <div class="pva__stats">
        <div class="pva__stat"><p class="pva__stat-lab">Bevindingen prio 1–3</p><p class="pva__stat-num">18</p></div>
        <div class="pva__stat"><p class="pva__stat-lab">Openstaande maatregelen</p><p class="pva__stat-num">24</p></div>
        <div class="pva__stat"><p class="pva__stat-lab">Afgerond</p><p class="pva__stat-num">6</p></div>
        <div class="pva__stat pva__stat--alert"><p class="pva__stat-lab">Verlopen deadline</p><p class="pva__stat-num">2</p></div>
      </div>
      <div class="pva__filters">
        <span class="chip chip--active">Alles</span>
        <span class="chip">Organisatiebreed</span>
        <span class="chip">Hoofdvestiging</span>
        <span class="chip">Vestiging Noord</span>
      </div>
      <div class="pva__table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Prio</th>
              <th scope="col">Onderwerp</th>
              <th scope="col">Maatregel</th>
              <th scope="col">Status</th>
              <th scope="col">Deadline</th>
              <th scope="col">Verantwoordelijke</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="tag tag--alert">1 Hoog</span></td>
              <td class="td-bold">Tillen en dragen</td>
              <td class="td-muted">Tilhulp plaatsen bij het orderverzamelen</td>
              <td>In uitvoering</td>
              <td class="nowrap">15 jan</td>
              <td>Locatiemanager</td>
            </tr>
            <tr>
              <td><span class="tag tag--warn">2 Substantieel</span></td>
              <td class="td-bold">Aanrijdgevaar</td>
              <td class="td-muted">Looproutes markeren en heftruckinstructie vastleggen</td>
              <td>Open</td>
              <td class="nowrap">1 feb</td>
              <td>Technische dienst</td>
            </tr>
            <tr>
              <td><span class="tag tag--soft">Meer info nodig</span></td>
              <td class="td-bold">Vervoermiddelen</td>
              <td class="td-muted">Keuring bedrijfsbus nagaan bij de rondgang</td>
              <td>Open</td>
              <td>—</td>
              <td>Veiligheidskundige</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <p class="caption">Nagebouwd scherm met voorbeeldgegevens</p>
  </section>

  <!-- Update -->
  <section aria-labelledby="update" class="container section">
    <div class="update">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#10362D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 11a8 8 0 0 0-14.9-3.9"></path>
        <path d="M4 4v4h4"></path>
        <path d="M4 13a8 8 0 0 0 14.9 3.9"></path>
        <path d="M20 20v-4h-4"></path>
      </svg>
      <div>
        <h2 id="update" class="update__title">Elk jaar vers, zonder nieuw traject</h2>
        <p class="update__body">
          Eén keer per jaar voeren dezelfde rollen een nieuwe ronde AI-voicegesprekken per
          vestiging. Zo zie je wat er is veranderd, wat is opgelost en wat er nieuw bij kwam,
          en blijft je RI&amp;E actueel. Een vergelijking met vorig jaar in het rapport is in
          ontwikkeling.
        </p>
      </div>
    </div>
  </section>

  <!-- Ervaringen -->
  <section aria-labelledby="ervaringen" class="container section">
    <p class="eyebrow">Uit de praktijk</p>
    <h2 id="ervaringen" class="h2">Zo deed Microtherm het: zelf, met een externe toetser</h2>
    <p class="section__lead">
      Microtherm Kunststoffen, werkmaatschappij van Vink Groep, deed de RI&amp;E met de eigen
      KAM-adviseur van Vink. Wij richtten samen in; de rest liep op het platform.
    </p>
    <!--
      TODO: Na 8 december 2026 moet de toetsing bij Microtherm in de verleden tijd,
      liefst met een quote van de toetser.
    -->
    <ol class="stepcards">
      <li class="stepcard">
        <p class="stepcard__kicker">Stap 1 · 7 oktober</p>
        <h3>Samen inrichten</h3>
        <p>
          De KAM-adviseur van Vink legde met ons het organisatieprofiel en de onderwerpen
          vast, en de kick-off volgde met de deelnemers.
        </p>
      </li>
      <li class="stepcard">
        <p class="stepcard__kicker">Stap 2 · oktober</p>
        <h3>AI-voicegesprekken</h3>
        <p>
          Zes deelnemers, van directie tot OR, voerden samen 42 AI-voicegesprekken van tien
          tot vijftien minuten.
        </p>
      </li>
      <li class="stepcard">
        <p class="stepcard__kicker">Stap 3 · eind oktober en november</p>
        <h3>Concept en rondgang</h3>
        <p>Een concept-RI&amp;E met plan van aanpak, daarna de rondgang op locatie.</p>
      </li>
      <li class="stepcard stepcard--future">
        <p class="stepcard__kicker stepcard__kicker--muted">Stap 4 · 8 december</p>
        <h3>Toetsing</h3>
        <p>
          Een externe hogere veiligheidskundige toetst de RI&amp;E en het plan van aanpak.
        </p>
      </li>
    </ol>
    <div class="quotes-row">
      <figure class="quote-card">
        <blockquote>
          “De tool deed precies wat ik ervan had verwacht en gehoopt.”
        </blockquote>
        <figcaption>
          <strong>Erik Duis</strong>, KAM &amp; MVO-adviseur Vink Groep
        </figcaption>
      </figure>
      <figure class="quote-card">
        <blockquote>
          “Hij onthield wat ik in eerdere gesprekken had gezegd. Fijn dat je niet drie keer
          hetzelfde hoeft te zeggen.”
        </blockquote>
        <figcaption>
          <strong>Kevin Visser</strong>, general manager Microtherm
        </figcaption>
      </figure>
      <div class="nps">
        <p class="nps__head">
          Bij de Safety Culture Ladder-trajecten van Enexis, met dezelfde AI-interviewer:
        </p>
        <p class="nps__big">85%</p>
        <p class="nps__body">van de deelnemers zou opnieuw meedoen. 90% was zeer positief.</p>
      </div>
    </div>
  </section>

  <!-- Adviseur + prijzen -->
  <section aria-labelledby="adviseur" class="container section">
    <h2 id="adviseur" class="h2">Met of zonder eigen adviseur</h2>
    <div class="grid adv-grid">
      <div class="adv-card">
        <h3>Je werkt al met een adviesbureau</h3>
        <p>
          Dan blijft je adviseur aan het stuur. Vraag of je bureau met RIEfresh werkt, of laat
          ons contact met ze opnemen.
        </p>
      </div>
      <div class="adv-card">
        <h3>Je doet het zelf, zoals Microtherm</h3>
        <p>
          Wij richten samen met jou in. Voor de rondgang en de toetsing koppelen we een
          externe veiligheidskundige uit ons netwerk, of je werkt met je eigen toetser.
        </p>
      </div>
    </div>
    <div id="prijzen" class="prijzen">
      <h3 class="prijzen__title">Wat het kost</h3>
      <p class="prijzen__lead">
        Vaste prijzen per vestiging, vooraf bekend. Alle bedragen exclusief btw.
      </p>
      <!-- TODO: Prijzen staan ter bevestiging bij Jaap. Bron: src/data/pricing.ts -->
      <div class="prijzen__grid">
        <div class="prijs prijs--hi">
          <p class="prijs__kicker">RI&amp;E via AI-voicegesprekken</p>
          <p class="prijs__num">{kamPricing.eerstVestiging}</p>
          <p class="prijs__sub">
            eerste vestiging, {kamPricing.volgendeVestiging} per volgende vestiging
          </p>
          <p class="prijs__body">
            Inrichting, de AI-voicegesprekken, bevindingen met risicoscore en een concept-plan
            van aanpak.
          </p>
        </div>
        <div class="prijs">
          <p class="prijs__kicker">Toetsing en rondgang</p>
          <p class="prijs__num">{kamPricing.toetsingPerVestiging}</p>
          <p class="prijs__sub">per vestiging</p>
          <p class="prijs__body">
            Een externe veiligheidskundige uit ons netwerk komt langs, toetst en tekent. Niet
            nodig als je met je eigen toetser werkt.
          </p>
        </div>
        <div class="prijs">
          <p class="prijs__kicker">Jaarlijkse update</p>
          <p class="prijs__num">{kamPricing.jaarlijkseUpdatePerVestiging}</p>
          <p class="prijs__sub">per vestiging per jaar, vanaf jaar 2</p>
          <p class="prijs__body">
            Een nieuwe ronde AI-voicegesprekken, zodat je RI&amp;E actueel blijft.
          </p>
        </div>
      </div>
      <div class="prijzen__cta">
        <p>
          <strong>Voorbeeld:</strong> één vestiging met toetsing kost
          {kamPricing.rekenvoorbeeld} in het eerste jaar.
        </p>
        <a href="#demo" class="btn btn-primary btn-sm">Plan een demo</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="vragen" aria-labelledby="vragen-titel" class="container section faq">
    <div class="faq__intro">
      <h2 id="vragen-titel" class="h2">Vragen van KAM-managers</h2>
    </div>
    <div class="faq__list">
      {faqs.map((f) => <FaqItem question={f.q}><p>{f.a}</p></FaqItem>)}
    </div>
  </section>

  <!-- Demo -->
  <section id="demo" aria-labelledby="demo-titel" class="container demo-section">
    <div class="demo">
      <div class="demo__text">
        <h2 id="demo-titel" class="h2">Begin bij één vestiging</h2>
        <p class="demo__lead">
          In de demo laten we zien hoe een RI&amp;E voor jouw organisatie eruitziet: wie er
          meedoet, hoe lang het duurt en wat je krijgt.
        </p>
      </div>
      <DemoForm
        formName="demo-kam"
        selectLabel="Aantal vestigingen"
        selectName="vestigingen"
        options={[{ value: "1" }, { value: "2 tot 5" }, { value: "Meer dan 5" }]}
      />
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    padding: 48px var(--pad-x) 88px;
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }
  .hero__text { flex: 1 1 500px; min-width: 0; }
  .hero__title {
    font-size: clamp(40px, 5.2vw, 64px);
    line-height: 1.04;
    font-weight: 700;
    margin: 18px 0 0;
  }
  .hero__lead {
    margin: 24px 0 0;
    font-size: 19px;
    color: var(--c-text-2);
    max-width: 580px;
  }
  .hero__cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__side { flex: 1 1 420px; min-width: 0; }
  .hero__note {
    margin: 10px 0 0;
    font-size: 12px;
    color: #5C6862;
  }

  .vestigingen {
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: 22px;
    padding: 26px;
    box-shadow: var(--shadow-card);
  }
  .vestigingen__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .vestigingen__title { font-weight: 700; font-size: 17px; }
  .vestigingen__meta { font-size: 13px; color: var(--c-text-2); }
  .vestigingen__list {
    margin: 18px 0 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .vestigingen__list li {
    border: 1px solid var(--c-border);
    border-radius: 14px;
    padding: 14px 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    align-items: center;
  }
  .vestigingen__sub {
    font-size: 14px;
    color: var(--c-text-2);
    display: block;
  }
  .badge {
    font-size: 13px;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .badge--ok { background: var(--c-ok-bg); color: var(--c-ok-fg); }
  .badge--warn { background: var(--c-warn-bg); color: var(--c-warn-fg); }
  .badge--soft { background: var(--c-bg-soft); color: var(--c-primary); }

  /* Herkenbaar */
  .herkenbaar { padding: 80px var(--pad-x); }
  .herkenbaar__title { max-width: 760px; }
  .herkenbaar__grid {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }
  .herkenbaar__card {
    border-top: 2px solid var(--c-lime);
    padding-top: 18px;
  }
  .herkenbaar__card h3 { font-size: 20px; margin: 0 0 8px; }
  .herkenbaar__card p { color: var(--c-text-dark); }
  .sources {
    margin: 36px 0 0;
    font-size: 13px;
    color: #B5C7BF;
  }

  /* H2 helpers */
  .h2 {
    font-size: clamp(30px, 3.6vw, 44px);
    margin-top: 10px;
    max-width: 760px;
  }
  .h2--max820 { max-width: 820px; }
  .section__lead {
    margin: 20px 0 0;
    font-size: 17px;
    color: var(--c-text-2);
    max-width: 820px;
  }

  /* Roles */
  .roles {
    margin-top: 36px;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
  }
  .role {
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: 18px;
    padding: 24px;
  }
  .role--dark {
    background: var(--c-primary);
    color: #fff;
    border-color: transparent;
  }
  .role--dark p { color: var(--c-text-dark); }
  .role__kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #5C6862;
    margin: 0;
  }
