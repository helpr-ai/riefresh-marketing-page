---
interface Props {
  videoId: string;
  title: string;
}
const { videoId, title } = Astro.props;
---

<div
  class="video-embed"
  data-video-id={videoId}
  data-title={title}
>
  <button type="button" class="video-embed__poster" aria-label={`Laad en speel de video: ${title}`}>
    <span class="video-embed__label">RIEfresh</span>
    <span class="video-embed__play" aria-hidden="true">
      <svg width="30" height="30" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="#10362D"></path></svg>
    </span>
    <span class="video-embed__caption">Bekijk op YouTube</span>
  </button>
</div>

<style>
  .video-embed {
    flex: 1 1 460px;
    min-width: 0;
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--c-accent) 0%, var(--c-primary) 75%);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }
  .video-embed__poster {
    position: absolute;
    inset: 0;
    display: block;
    background: transparent;
    border: 0;
    color: #fff;
    cursor: pointer;
    text-align: left;
    padding: 0;
    font: inherit;
  }
  .video-embed__label {
    position: absolute;
    left: 28px;
    top: 24px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    color: #fff;
  }
  .video-embed__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .video-embed__play::before {
    content: "";
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    position: absolute;
    z-index: -1;
  }
  .video-embed__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .video-embed__play svg {
    background: #fff;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    padding: 27px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }
  .video-embed__caption {
    position: absolute;
    left: 28px;
    bottom: 22px;
    font-size: 15px;
    color: var(--c-bg-soft);
  }
  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".video-embed").forEach((wrap) => {
    const btn = wrap.querySelector<HTMLButtonElement>(".video-embed__poster");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const id = wrap.dataset.videoId;
      const title = wrap.dataset.title ?? "Video";
      if (!id) return;
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = title;
      iframe.setAttribute(
        "allow",
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      );
      iframe.allowFullscreen = true;
      btn.remove();
      wrap.appendChild(iframe);
    });
  });
</script>
